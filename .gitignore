# Dependency directories
node_modules/
jspm_packages/
web_modules/

# Debug logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (Next.js / Node.js)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc progress folder
.nyc_output

# Grunt build folder
.grunt

# Bower dependency directory
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons
build/Release

# Dependency directories for various package managers
.npm
.eslintcache
.stylelintcache
.cache
.parcel-cache

# Local environment variables files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
! .env.example

# Next.js build output
.next/
out/

# Nuxt.js build output
.nuxt/
dist/
.output/

# Serverless Webpack directories
.webpack/

# Optional npm cache directory
.npm/

# REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env

# TypeScript cache
*.tsbuildinfo

# OS generated files (Optional but recommended)
.DS_Store
Thumbs.db
